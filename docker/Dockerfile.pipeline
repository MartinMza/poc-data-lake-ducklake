# Imagen unificada de ejecución para Dulse Data Lake (ingesta, dbt, Prefect, backup/restore y descompresión).
FROM python:3.12-slim-bookworm

WORKDIR /workspace

# 1. Librerías de sistema, descompresión (.tar, .gz, .bz2, .xz, .zst, .zip, .7z) y clientes DB
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    gnupg \
    jq \
    git \
    tar \
    gzip \
    pigz \
    bzip2 \
    xz-utils \
    zstd \
    lz4 \
    unzip \
    p7zip-full \
    postgresql-client \
    unixodbc \
    unixodbc-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 2. Microsoft ODBC Driver 18 for SQL Server + mssql-tools18 (bcp y sqlcmd)
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        msodbcsql18 \
        mssql-tools18 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/mssql-tools18/bin:${PATH}"

# 3. Instalar uv para gestión rápida de entornos virtuales
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

# 4. Pre-construir los entornos virtuales de los módulos del proyecto
COPY bronze/requirements.txt /workspace/bronze/requirements.txt
COPY dbt/requirements.txt /workspace/dbt/requirements.txt
COPY orchestration/requirements.txt /workspace/orchestration/requirements.txt
COPY requirements.txt /workspace/requirements.txt

RUN uv venv /workspace/bronze/.venv --python 3.12 \
    && uv pip install -p /workspace/bronze/.venv/bin/python -r /workspace/bronze/requirements.txt \
    && uv venv /workspace/dbt/.venv --python 3.12 \
    && uv pip install -p /workspace/dbt/.venv/bin/python -r /workspace/dbt/requirements.txt \
    && uv venv /workspace/orchestration/.venv --python 3.12 \
    && uv pip install -p /workspace/orchestration/.venv/bin/python -r /workspace/orchestration/requirements.txt \
    && uv venv /workspace/.venv --python 3.12 \
    && uv pip install -p /workspace/.venv/bin/python -r /workspace/requirements.txt

# 5. Pre-instalar extensiones DuckDB (ducklake, postgres, httpfs) para evitar descargas en runtime
RUN /workspace/bronze/.venv/bin/python -c "import duckdb; con = duckdb.connect(); con.execute('INSTALL ducklake; INSTALL postgres; INSTALL httpfs;')"

COPY . /workspace

ENV PYTHONUNBUFFERED=1

CMD ["bash"]
