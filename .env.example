# Valores locales del PoC (copiar a .env para personalizar; nunca commitear .env).
# Todo es sintético y solo-PoC-local. Sin datos reales ni credenciales cloud.

# --- Postgres catálogo DuckLake (docker-compose: postgres-catalog) ---
CATALOG_DB=ducklake_catalog
CATALOG_USER=ducklake
CATALOG_PASSWORD=ducklake
CATALOG_PORT=5433

# --- Postgres origen simulado (workstream 3, no tocar desde este slice) ---
SOURCE_DB=source_db
SOURCE_USER=source_user
SOURCE_PASSWORD=source_password
SOURCE_PORT=5434

# --- Garage S3 (nodo único) ---
# Key ID con formato Garage: 'GK' + 32 hex. Secret: 64 hex.
# Deben coincidir con GARAGE_DEFAULT_* del compose (auto-provisión --default-bucket).
GARAGE_S3_KEY_ID=GK0123456789abcdef0123456789abcdef
GARAGE_S3_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_S3_KEY_NAME=ducklake-key
LAKEHOUSE_BUCKET=lakehouse
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_S3_REGION=garage
GARAGE_S3_ENDPOINT=http://localhost:3900

# --- DuckLake ---
DUCKLAKE_DATA_PATH=s3://lakehouse/data/

# --- Prefect ---
PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api

# --- SQL Server origen (OpenSpec mssql-bak-source, tarea 2.1) ---
# Password del login SA. SIN default: el compose falla explícito si está vacía.
# Requisitos de SQL Server: >=8 caracteres con mayúscula, minúscula, dígito y símbolo.
# Solo-PoC-local: nunca commitear el .env con la password real.
MSSQL_SA_PASSWORD=ChangeMe!Str0ng1
# Puerto host del servicio mssql (verificado libre el 1433 en el host PoC;
# si está ocupado, cambiar aquí sin tocar el compose).
MSSQL_PORT=1433
# El .bak diario del operador se coloca en ./mssql-backup/ (gitignored),
# visible dentro del contenedor en /var/opt/mssql/backup/. No commitear .bak.
