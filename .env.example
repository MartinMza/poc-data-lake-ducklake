# Valores locales del PoC (copiar a .env para personalizar; nunca commitear .env).
# Stack local: la única fuente de datos es el SQL Server restaurado desde .bak.
# Sin credenciales cloud.
#
# Regla: ninguna variable combina valores. Host y puerto van por separado;
# esquema, bucket y prefijo van por separado. Los valores compuestos (DSN,
# endpoint S3, ruta del lago) los arma la aplicación.

# --- Postgres catálogo DuckLake (docker-compose: postgres-catalog) ---
CATALOG_HOST=localhost
DOCKER_CATALOG_HOST=postgres-catalog
CATALOG_PORT=5433
CATALOG_INTERNAL_PORT=5432
CATALOG_DB=ducklake_catalog
CATALOG_USER=ducklake
CATALOG_PASSWORD=ducklake

# --- Garage S3 (nodo único) ---
# Key ID con formato Garage: 'GK' + 32 hex. Secret: 64 hex.
# Deben coincidir con GARAGE_DEFAULT_* del compose (auto-provisión --default-bucket).
GARAGE_SCHEME=http
GARAGE_HOST=localhost
DOCKER_GARAGE_HOST=garage
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_S3_KEY_ID=GK0123456789abcdef0123456789abcdef
GARAGE_S3_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_S3_KEY_NAME=ducklake-key
LAKEHOUSE_BUCKET=lakehouse
GARAGE_S3_REGION=garage

# --- DuckLake ---
# La ruta del lago se compone como s3://<LAKEHOUSE_BUCKET>/<DUCKLAKE_DATA_PREFIX>/
# (el bucket ya se define en la sección Garage, no se repite acá).
DUCKLAKE_DATA_PREFIX=data

# --- Auth API REST + MCP ---
# Los usuarios y las API keys viven en Postgres (base `kavos_lake_auth`), no acá.
# Se administran desde el panel: http://localhost:8000/ui
# El primer arranque imprime un SETUP TOKEN de un solo uso en los logs del
# servicio; con ese token el panel crea el superAdmin.
AUTH_JWT_SECRET=
AUTH_JWT_TTL_MINUTES=60
# Base de credenciales: variables propias. No hereda nada del catálogo, así se
# puede apuntar a otro servidor sin tocar el lago.
AUTH_DB_HOST=localhost
DOCKER_AUTH_DB_HOST=postgres-catalog
AUTH_DB_PORT=5433
AUTH_DB_INTERNAL_PORT=5432
AUTH_DB_USER=ducklake
AUTH_DB_PASSWORD=ducklake
AUTH_DB_NAME=kavos_lake_auth
# Legado: si quedan definidas, se importan a la base una sola vez al arrancar
# (usuarios como usuarios, keys a nombre del usuario `service`) y después se
# ignoran. Se pueden vaciar una vez migradas.
AUTH_API_KEYS=
AUTH_USERS=

# --- CORS y seguridad del panel ---
# CORS: host y puerto van por separado (regla del PoC; la app deriva los orígenes).
# CORS_SCHEME: esquema (http o https).
# CORS_HOSTS: hosts permitidos (lista por comas) o '*' para wildcard.
# CORS_PORT: puerto del frontend/panel (default 8000; vacío para omitir puerto).
# Opcional legado: CORS_ALLOW_ORIGINS anula la composición si se pasa explícitamente.
CORS_SCHEME=http
CORS_HOSTS=localhost,127.0.0.1
CORS_PORT=8000
CORS_ALLOW_CREDENTIALS=false
# Cookie de sesión del panel con flag Secure (solo viaja por HTTPS).
# Default false para el PoC local sobre http://localhost; poné true con TLS.
SESSION_COOKIE_SECURE=false
# URL pública del panel para armar los links de activación detrás de un proxy
# (ej. https://panel.example.com). Vacío = se usa el host de la request.
PANEL_PUBLIC_URL=
# Rate-limiting de login (anti fuerza bruta). Bloqueo por usuario tras N fallos
# dentro de la ventana; es por-proceso (un worker). Con varios workers hace
# falta un store compartido.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCKOUT_SECONDS=300

# --- Prefect (docker-compose: prefect-server) ---
PREFECT_SCHEME=http
PREFECT_HOST=localhost
PREFECT_BIND_HOST=0.0.0.0
DOCKER_PREFECT_HOST=prefect-server
PREFECT_PORT=4200
PREFECT_INTERNAL_PORT=4200

# --- SQL Server origen (docker-compose: mssql) ---
MSSQL_HOST=localhost
DOCKER_MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_INTERNAL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=Str0ng!PoC-Local01

# --- API REST & MCP Server (docker-compose: lake-api) ---
API_HOST=localhost
API_BIND_HOST=0.0.0.0
API_PORT=8000
API_INTERNAL_PORT=8000

# --- Inicialización (docker-compose: lake-init) ---

# --- Adquisición automática del backup (Gmail -> link S3 -> mssql-backup/) ---
# Con ACQUIRE_IMAP_USER o ACQUIRE_LINK_HOSTS vacíos la adquisición se salta en
# éxito y el workflow manual con MSSQL_BAK_PATH sigue funcionando igual.
#
# Gmail exige una app password (con verificación en dos pasos activa): la
# contraseña normal de la cuenta no sirve para IMAP.
ACQUIRE_IMAP_USER=
ACQUIRE_IMAP_APP_PASSWORD=
# Remitente exacto (no sufijo) y asunto evaluado como regex.
ACQUIRE_FROM=info@finnegans.com.ar
ACQUIRE_SUBJECT_PATTERN=Backup de Base de Datos Disponible
# Allowlist de hosts separada por comas. Nunca un comodín libre del tipo
# *.amazonaws.com: eso habilitaría cualquier bucket de cualquier cuenta.
ACQUIRE_LINK_HOSTS=finnegans-virginia-db-backup-diario.s3.us-east-1.amazonaws.com
# Cadencia del poller y margen mínimo exigido a la firma presignada. La ventana
# del link es de 12 h (X-Amz-Expires=43200): espaciar más que eso es perderlos.
ACQUIRE_POLL_HOURS=4
ACQUIRE_MIN_WINDOW_SECONDS=1800
ACQUIRE_STATE_PATH=orchestration/.acquire_state.json
ACQUIRE_INCOMING_DIR=mssql-backup/.incoming
ACQUIRE_FINAL_DIR=mssql-backup
