# Valores locales del PoC (copiar a .env para personalizar; nunca commitear .env).
# Todo es sintético y solo-PoC-local. Sin datos reales ni credenciales cloud.

# --- Postgres catálogo DuckLake (docker-compose: postgres-catalog) ---
CATALOG_HOST=localhost
DOCKER_CATALOG_HOST=postgres-catalog
CATALOG_PORT=5433
CATALOG_INTERNAL_PORT=5432
CATALOG_DB=ducklake_catalog
CATALOG_USER=ducklake
CATALOG_PASSWORD=ducklake

# --- Postgres origen simulado (docker-compose: postgres-source) ---
SOURCE_HOST=localhost
DOCKER_SOURCE_HOST=postgres-source
SOURCE_PORT=5434
SOURCE_INTERNAL_PORT=5432
SOURCE_DB=source_db
SOURCE_USER=source_user
SOURCE_PASSWORD=source_password

# --- Garage S3 (nodo único) ---
# Key ID con formato Garage: 'GK' + 32 hex. Secret: 64 hex.
# Deben coincidir con GARAGE_DEFAULT_* del compose (auto-provisión --default-bucket).
GARAGE_SCHEME=http
GARAGE_HOST=localhost
DOCKER_GARAGE_HOST=garage
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
GARAGE_S3_KEY_ID=GK0123456789abcdef0123456789abcdef
GARAGE_S3_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_S3_KEY_NAME=ducklake-key
LAKEHOUSE_BUCKET=lakehouse
GARAGE_S3_REGION=garage

# --- DuckLake ---
DUCKLAKE_DATA_PATH=s3://lakehouse/data/

# --- Auth API REST + MCP (obligatorio; fail-closed) ---
# Dos credenciales equivalentes: API key (servicio/agentes) o JWT (personas).
# AUTH_API_KEYS: lista separada por comas. AUTH_USERS: usuario:secreto[,...]
# donde el secreto puede ser plano o `pbkdf2_sha256$...` (scripts/hash_password.py).
# AUTH_JWT_SECRET debe tener 32+ bytes aleatorios (openssl rand -hex 32).
# Plantilla: NO incluye credenciales utilizables a propósito (nunca commitear
# valores reales). scripts/setup.sh genera API key + secreto JWT si están vacíos.
#   AUTH_API_KEYS    -> openssl rand -hex 24
#   AUTH_JWT_SECRET  -> openssl rand -hex 32  (32+ bytes obligatorios)
#   AUTH_USERS       -> api/.venv/bin/python scripts/hash_password.py
AUTH_API_KEYS=
AUTH_USERS=
AUTH_JWT_SECRET=
AUTH_JWT_TTL_MINUTES=60

# --- Prefect (docker-compose: prefect-server) ---
PREFECT_SCHEME=http
PREFECT_HOST=localhost
PREFECT_BIND_HOST=0.0.0.0
DOCKER_PREFECT_HOST=prefect-server
PREFECT_PORT=4200
PREFECT_INTERNAL_PORT=4200

# --- SQL Server origen (docker-compose: mssql) ---
MSSQL_HOST=localhost
DOCKER_MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_INTERNAL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=Str0ng!PoC-Local01

# --- API REST & MCP Server (docker-compose: lake-api) ---
API_HOST=localhost
API_BIND_HOST=0.0.0.0
API_PORT=8000
API_INTERNAL_PORT=8000

# --- Inicialización (docker-compose: lake-init) ---
SEED_SCALE=demo
